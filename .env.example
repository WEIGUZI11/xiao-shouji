# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: Discord Developer Portal OAuth2 Client ID for the small phone community gate.
# Players never see this field; it is used to build https://discord.com/oauth2/authorize directly.
VITE_DISCORD_CLIENT_ID=""

# Optional: backend URL used by the hidden backdoor login. Do not put the secret code in the APK.
VITE_COMMUNITY_BACKDOOR_API_URL=""
VITE_API_PROXY_TARGET=""
VITE_NAI_PROXY_URL="/api/nai/generate-image"
VITE_PROACTIVE_REMINDER_API_URL=""

# Server-only settings for `npm run backdoor:server`.
# Keep these on your server. Do not expose them in client builds or commit real values.
COMMUNITY_BACKDOOR_PORT="8787"
COMMUNITY_BACKDOOR_SECRET=""
COMMUNITY_BACKDOOR_STATIC_CODE=""
COMMUNITY_BACKDOOR_ADMIN_TOKEN=""
COMMUNITY_BACKDOOR_ALLOWED_ORIGIN="*"

# Optional server-side NovelAI proxy for /api/nai/generate-image.
# Put the real key only in the hosting/server environment, never in committed files or APK source.
NAI_TOKEN=""
NAI_API_KEY=""
NOVELAI_API_KEY=""
# Recommended for users in mainland China: point the app at your own reachable relay.
NAI_RELAY_URL=""
NAI_API_URL="https://image.novelai.net/ai/generate-image"
NAI_HTTPS_PROXY=""
NAI_ALLOWED_ORIGIN="*"
NAI_TIMEOUT_MS="45000"
NAI_PROXY_PORT="8789"
NAI_PROXY_BODY_LIMIT="2mb"

# Optional local-only Doubao TTS smoke test settings (`npm run doubao:tts:test`).
# New console: set API key and leave APP_ID empty.
# Old console: set APP_ID plus Access Token in DOUBAO_TTS_TOKEN.
DOUBAO_TTS_API_KEY=""
DOUBAO_TTS_APP_ID=""
DOUBAO_TTS_TOKEN=""
DOUBAO_TTS_RESOURCE_ID="seed-tts-2.0"
DOUBAO_TTS_MODEL="seed-tts-2.0-standard"
DOUBAO_TTS_VOICE_ID=""

# Server-side proactive reminder scheduler.
PROACTIVE_REMINDER_STORE_PATH=""
PROACTIVE_REMINDER_TICK_MS="30000"
EXPO_PUSH_URL="https://exp.host/--/api/v2/push/send"
